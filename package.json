{
  "name": "@monobilisim/typescript-agi",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "description": "TypeScript library for Asterisk AGI interfaces",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts && tsc",
    "test": "bun test",
    "check": "tsc --noEmit && tsc -p tests",
    "format": "bun fmt --write .",
    "docs": "typedoc"
  },
  "author": "Mono Bilişim",
  "contributors": [
    "Fabio Theodoro <fabio@ipcom.com.br> (IPCOM fork)",
    "Brandon Lehmann <brandonlehmann@gmail.com> (original author)"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.5",
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monobilisim/typescript-agi.git"
  }
}
